+type JournalEntry = { path: string; content: string | null };
+
+async function openJournal(cwd: string, paths: string[], createdDir: string) {
+  const journalPath = path.join(cwd, ".changeset", ".apply-release-plan.journal");
+  const entries: JournalEntry[] = [];
+  for (const p of paths) {
+    try {
+      entries.push({
+        path: p,
+        content: (await fs.readFile(p)).toString("base64"),
+      });
+    } catch (err: any) {
+      if (err?.code !== "ENOENT" && err?.code !== "EISDIR") throw err;
+      entries.push({ path: p, content: null });
+    }
+  }
+  const dirExisted = await fs.stat(createdDir).then(
+    () => true,
+    () => false,
+  );
+  const changesetDir = path.dirname(journalPath);
+  const changesetDirExisted = await fs.stat(changesetDir).then(
+    () => true,
+    () => false,
+  );
+  await fs.mkdir(changesetDir, { recursive: true });
+  const handle = await fs.open(journalPath, "w");
+  try {
+    await handle.writeFile(
+      JSON.stringify({ version: 1, entries, createdDir, dirExisted }),
+    );
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+  return {
+    async rollback() {
+      for (const entry of entries) {
+        if (entry.content === null) {
+          await fs.rm(entry.path, { recursive: true, force: true });
+        } else {
+          await fs.writeFile(entry.path, Buffer.from(entry.content, "base64"));
+        }
+      }
+      if (!dirExisted) {
+        await fs.rm(createdDir, { recursive: true, force: true });
+      }
+    },
+    async remove() {
+      await fs.rm(journalPath, { force: true });
+      if (!changesetDirExisted) {
+        await fs.rmdir(changesetDir).catch(() => {});
+      }
+    },
+  };
+}
