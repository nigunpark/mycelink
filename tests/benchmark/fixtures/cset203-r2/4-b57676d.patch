+async function recoverInterruptedRun(cwd: string) {
+  const journalPath = path.join(cwd, ".changeset", ".apply-release-plan.journal");
+  let raw: string;
+  try {
+    raw = await fs.readFile(journalPath, "utf8");
+  } catch (err: any) {
+    if (err?.code === "ENOENT") return;
+    throw err;
+  }
+  let journal: {
+    entries: { path: string; content: string | null }[];
+    createdDir: string;
+    dirExisted: boolean;
+  };
+  try {
+    journal = JSON.parse(raw);
+  } catch {
+    log.error(
+      `The journal ${journalPath} of an interrupted run is unreadable. Remove it manually after checking your files.`,
+    );
+    throw new ExitError(1);
+  }
+  for (const entry of journal.entries) {
+    if (entry.content === null) {
+      await fs.rm(entry.path, { recursive: true, force: true });
+    } else {
+      await fs.writeFile(entry.path, Buffer.from(entry.content, "base64"));
+    }
+  }
+  if (!journal.dirExisted) {
+    await fs.rm(journal.createdDir, { recursive: true, force: true });
+  }
+  await fs.rm(journalPath, { force: true });
+  log.warn(
+    "A previous `changeset version` run was interrupted. Its changes have been restored before versioning again.",
+  );
+}
