  "criteria": [
    {
      "id": "AC-1",
      "kind": "new-behavior",
      "text": "**AC-1 — rollback (apply-release-plan).** If `applyReleasePlan` fails after\nit has started changing files, it restores every file it changed, created or\ndeleted to its exact previous bytes (or absence) and removes directories it\ncreated, and only then rejects. The rejection's `cause` is the original\nerror.",
      "sha256": "2bac8c23f94a2b969871b74a9022186f795a1217f9af38f1adfaa11a83982da2",
      "clauses": [
        {
          "id": "AC-1.1",
          "text": "If `applyReleasePlan` fails after it has started changing files, it restores every file it changed, created or deleted to its exact previous bytes (or absence) and removes directories it created, and only then rejects."
        },
        {
          "id": "AC-1.2",
          "text": "The rejection's `cause` is the original error."
        }
      ],
      "producers": [
        "CSET-203.changesets.apply-release-plan.impl"
      ],
      "verifiers": []
    },
    {
      "id": "AC-2",
      "kind": "new-behavior",
      "text": "**AC-2 — journal (apply-release-plan).** Before its first change,\n`applyReleasePlan` durably records what it is about to change in a recovery\njournal stored inside `.changeset/` under a name that starts with `.`, so it\nis never read as a changeset. It removes the journal once the run has\ncompleted, successfully or after a rollback. The journal's format is up to\nyou.",
      "sha256": "93944296ecc8cf35bb256b49d02df8babf94bf2960e08127fb82fbdf2a4c9041",
      "clauses": [
        {
          "id": "AC-2.1",
          "text": "Before its first change, `applyReleasePlan` durably records what it is about to change in a recovery journal stored inside `.changeset/` under a name that starts with `.`, so it is never read as a changeset."
        },
        {
          "id": "AC-2.2",
          "text": "It removes the journal once the run has completed, successfully or after a rollback."
        },
        {
          "id": "AC-2.3",
          "text": "The journal's format is up to you."
        }
      ],
      "producers": [
        "CSET-203.changesets.apply-release-plan.impl"
      ],
      "verifiers": []
    },
    {
      "id": "AC-3",
      "kind": "new-behavior",
      "text": "**AC-3 — recovery (CLI).** Before it reads anything else, `changeset\nversion` looks for a journal left by an interrupted run — for example after\nthe process was killed while applying. If it finds one, it restores the\nstate recorded in it, removes the journal, prints a warning that contains\nthe word `interrupted`, and then versions normally. The final result is the\nsame as one uninterrupted run: every package is bumped once and every\nchangeset is consumed once.",
      "sha256": "2125e3a930cf11d4dd9f590c3fde303c3cf3db3be81010698fbf8fac4ff1a8cb",
      "clauses": [
        {
          "id": "AC-3.1",
          "text": "Before it reads anything else, `changeset version` looks for a journal left by an interrupted run — for example after the process was killed while applying."
        },
        {
          "id": "AC-3.2",
          "text": "If it finds one, it restores the state recorded in it, removes the journal, prints a warning that contains the word `interrupted`, and then versions normally."
        },
        {
          "id": "AC-3.3",
          "text": "The final result is the same as one uninterrupted run: every package is bumped once and every changeset is consumed once."
        }
      ],
      "producers": [
        "CSET-203.changesets.cli.impl"
      ],
      "verifiers": []
    },
    {
      "id": "AC-4",
      "kind": "new-behavior",
      "text": "**AC-4 — failure (CLI).** When applying the release plan fails,\n`changeset version` prints the failure without a stack trace and exits with\ncode `1`. It does not run `git add` or `git commit` for that run, even when\n`commit` is enabled in the config.",
      "sha256": "394243464190315bae3c17bbfcc1dd3b27e605b3cada6c64e7b52b3aaaa3569b",
      "clauses": [
        {
          "id": "AC-4.1",
          "text": "When applying the release plan fails, `changeset version` prints the failure without a stack trace and exits with code `1`."
        },
        {
          "id": "AC-4.2",
          "text": "It does not run `git add` or `git commit` for that run, even when `commit` is enabled in the config."
        }
      ],
      "producers": [
        "CSET-203.changesets.cli.impl"
      ],
      "verifiers": []
    },
    {
      "id": "AC-5",
      "kind": "compatibility",
      "text": "**AC-5 — compatibility.** A run that succeeds produces exactly the same files\nas today and leaves no journal behind. `changeset status` and\n`changeset add` are unaffected by a journal.",
      "sha256": "c8ef763e5e1583bcfa8ea2e7814f5ba9d552790537dcf72a17ca206ee732a5e6",
      "clauses": [
        {
          "id": "AC-5.1",
          "text": "A run that succeeds produces exactly the same files as today and leaves no journal behind."
        },
        {
          "id": "AC-5.2",
          "text": "`changeset status` and `changeset add` are unaffected by a journal."
        }
      ],
      "producers": [
        "CSET-203.changesets.apply-release-plan.impl",
        "CSET-203.changesets.cli.impl"
      ],
      "verifiers": [
        "CSET-203.changesets.compat.verify"
      ]
    }
  ],
