{
  "name": "mycelink",
  "version": "0.2.0-beta.1",
  "description": "Connect repositories. Coordinate agents. Ship one feature.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "bin": {
    "mycelink": "bin/mycelink.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:fixture": "vitest run tests/fixtures",
    "test:plugin": "vitest run tests/plugin-e2e",
    "test:pilot": "vitest run --config vitest.pilot.config.ts",
    "verify": "npm run typecheck && npm run build && vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "author": "Mycelink Contributors"
}
