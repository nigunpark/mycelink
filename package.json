{
  "name": "mycelink",
  "version": "0.3.0-beta.1",
  "description": "Connect repositories. Coordinate agents. Ship one feature.",
  "license": "Apache-2.0",
  "author": "Mycelink Contributors",
  "homepage": "https://github.com/nigunpark/mycelink#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nigunpark/mycelink.git"
  },
  "bugs": {
    "url": "https://github.com/nigunpark/mycelink/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "bin": {
    "mycelink": "bin/mycelink.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs && git diff --exit-code -- dist THIRD_PARTY_NOTICES.md schemas/acceptance-review-verdict.schema.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test-suites.mjs all",
    "test:unit": "node scripts/test-suites.mjs run unit",
    "test:integration": "node scripts/test-suites.mjs run integration",
    "test:security": "node scripts/test-suites.mjs run security",
    "test:fixture": "node scripts/test-suites.mjs run fixtures",
    "test:release": "node scripts/test-suites.mjs run release",
    "test:plugin": "node scripts/test-suites.mjs run plugin-e2e",
    "test:pilot": "vitest run --config vitest.pilot.config.ts",
    "test:benchmark": "node scripts/test-suites.mjs run benchmark",
    "bench:cases:check": "node evals-public-projects/tools/generate-cases.mjs --check",
    "bench:selftest": "node evals-public-projects/tools/selftest.mjs",
    "audit:constraints:check": "node scripts/constraint-audit.mjs --check",
    "package": "node scripts/package.mjs",
    "validate:plugin": "claude plugin validate --strict .",
    "verify": "npm run typecheck && npm run build && node scripts/test-suites.mjs all",
    "test:ci": "node scripts/test-suites.mjs ci"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
