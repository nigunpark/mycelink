{
  "name": "mycelink",
  "version": "0.2.0-beta.1",
  "description": "Connect repositories. Coordinate agents. Ship one feature.",
  "license": "Apache-2.0",
  "author": "Mycelink Contributors",
  "homepage": "https://github.com/nigunpark/mycelink#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nigunpark/mycelink.git"
  },
  "bugs": {
    "url": "https://github.com/nigunpark/mycelink/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "bin": {
    "mycelink": "bin/mycelink.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs && git diff --exit-code -- dist THIRD_PARTY_NOTICES.md",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:fixture": "vitest run tests/fixtures",
    "test:release": "vitest run tests/release",
    "test:plugin": "vitest run tests/plugin-e2e",
    "test:pilot": "vitest run --config vitest.pilot.config.ts",
    "package": "node scripts/package.mjs",
    "validate:plugin": "claude plugin validate --strict .",
    "verify": "npm run typecheck && npm run build && vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
