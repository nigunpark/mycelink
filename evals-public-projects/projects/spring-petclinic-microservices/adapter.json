{
  "schema": "mycelink-bench/project-adapter@1",
  "id": "spring-petclinic-microservices",
  "name": "Spring PetClinic Microservices",
  "implementation": "maven-junit",
  "source_lock": "source.lock.json",
  "workspace": { "repo_dir": "repos/spring-petclinic-microservices", "branch": "main" },
  "modules": [
    { "id": "admin-server", "path": "spring-petclinic-admin-server", "description": "Spring Boot Admin server" },
    { "id": "api-gateway", "path": "spring-petclinic-api-gateway", "description": "Spring Cloud Gateway: routes /api/{customer,visit,vet,genai}/**, owner-details aggregation, the Vue UI" },
    { "id": "config-server", "path": "spring-petclinic-config-server", "description": "Spring Cloud Config server" },
    { "id": "customers-service", "path": "spring-petclinic-customers-service", "description": "owners, pets and pet types (JPA, HSQLDB or MySQL)" },
    { "id": "discovery-server", "path": "spring-petclinic-discovery-server", "description": "Eureka service registry" },
    { "id": "genai-service", "path": "spring-petclinic-genai-service", "description": "Spring AI chat assistant (needs an external model; no tests upstream)" },
    { "id": "vets-service", "path": "spring-petclinic-vets-service", "description": "veterinarians and specialties (JPA, cached)" },
    { "id": "visits-service", "path": "spring-petclinic-visits-service", "description": "pet visits (JPA, HSQLDB or MySQL)" }
  ],
  "shared_paths": ["pom.xml", "mvnw", "mvnw.cmd", ".mvn/**", "docker/**", "docker-compose.yml", "docs/**", "scripts/**", ".github/**", "README.md", "CONTRIBUTING.md", "LICENSE"],
  "test_paths": ["*/src/test/**"],
  "toolchain": {
    "runtime": "java",
    "versions": { "java": "21", "maven": "3.9.8" },
    "cache": { "kind": "maven-repository", "dir": "m2/spring-petclinic", "wrapper_dir": "maven-user-home/spring-petclinic" }
  },
  "env": { "TZ": "UTC", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8" },
  "commands": {
    "timeout_seconds": 1800,
    "maven_args": ["-B", "-o", "-Dspring-boot.build-image.skip=true"]
  },
  "tolerated_build_mutations": [],
  "baseline_exclusions": [],
  "harness": {
    "frozen": ["**/pom.xml", "mvnw", "mvnw.cmd", ".mvn/**"],
    "forbidden_new": ["**/pom.xml", "**/.mvn/**", "**/junit-platform.properties", "**/META-INF/services/**", "**/META-INF/spring.factories", "**/META-INF/spring/**", "**/surefire*", "**/failsafe*"],
    "framework_modules": ["org.junit", "junit.framework", "org.assertj", "org.hamcrest", "org.opentest4j", "org.mockito", "org.springframework.test", "org.springframework.boot.test", "org.apache.maven.surefire", "okhttp3.mockwebserver", "mockwebserver3.MockWebServer", "com.tngtech.archunit"],
    "manifests": "none"
  },
  "workspace_notes": [
    "Maven runs offline from a pre-populated local repository; do not add dependencies.",
    "Tests that start a service use the embedded HSQLDB of the `test` profile; MockWebServer (okhttp mockwebserver3) is on the api-gateway test classpath.",
    "Pin the time zone when you compare dates: the trusted test run uses TZ=UTC."
  ]
}
