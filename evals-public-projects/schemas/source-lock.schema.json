{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelink.invalid/bench/source-lock.schema.json",
  "title": "Frozen upstream source identity",
  "description": "Binds an upstream project to one remote, commit, tree, content digest, history and license set. The git bundle is transport only: it is verified offline by what it holds (its SHA-256 is recorded as advisory), and the agent workspace is cloned from it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "remote", "commit", "tree", "object_format", "content", "history", "bundle", "license", "identity_sha256"],
  "properties": {
    "schema": { "const": "mycelink-bench/source-lock@2" },
    "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "remote": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(/[A-Za-z0-9._-]+)+\\.git$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "object_format": { "const": "sha1" },
    "content": {
      "description": "SHA-256 over every entry of the commit's tree: path, mode and the SHA-256 of its content (a submodule by commit id); independent of SHA-1.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_sha256", "files"],
      "properties": {
        "tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "files": { "type": "integer", "minimum": 1 }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "commits", "shallow_boundary", "digest_sha256"],
      "properties": {
        "kind": { "enum": ["complete", "shallow"] },
        "commits": { "type": "integer", "minimum": 1 },
        "digest_sha256": { "description": "SHA-256 of the sorted commit ids of the history (one per line, each newline-terminated).", "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "shallow_boundary": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "version", "refs", "prerequisites", "transport"],
      "properties": {
        "file": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,120}\\.bundle$" },
        "version": { "enum": [2, 3] },
        "transport": {
          "description": "The bytes of the bundle the lock was made with: advisory (a re-made bundle may differ and is verified by content).",
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "size"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "size": { "type": "integer", "minimum": 1 }
          }
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha"],
            "properties": {
              "name": { "type": "string", "pattern": "^(HEAD|refs/[A-Za-z0-9._/-]+)$" },
              "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            }
          }
        },
        "prerequisites": { "type": "array", "maxItems": 0 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "files"],
      "properties": {
        "spdx": { "enum": ["Apache-2.0", "MIT"] },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "blob"],
            "properties": {
              "path": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$" },
              "blob": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            }
          }
        }
      }
    },
    "identity_sha256": {
      "description": "SHA-256 of the canonical JSON of {remote, commit, tree, object_format, content, history, license} (never the transport bytes).",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
