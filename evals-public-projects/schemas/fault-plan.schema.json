{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelink.invalid/bench/fault-plan.schema.json",
  "title": "Evaluator fault plan",
  "description": "Faults the evaluator injects into a fault-injected arm, and the trigger for each. The same plan applies to both orchestration arms.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "faults"],
  "properties": {
    "schema": { "const": "mycelink-bench/fault-plan@1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "faults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "trigger"],
        "properties": {
          "kind": { "enum": ["interrupt-restart", "stale-result", "duplicate-result", "concurrent-commit", "late-hidden-defect"] },
          "trigger": {
            "type": "object",
            "additionalProperties": false,
            "required": ["on"],
            "properties": {
              "on": { "enum": ["first-commit", "commits", "elapsed-seconds", "session-end"] },
              "count": { "type": "integer", "minimum": 1 },
              "seconds": { "type": "integer", "minimum": 1 },
              "phase": {
                "description": "Scope a mid-session trigger to one phase of the run: its commits and seconds count from that phase's start, and it fires only while the phase runs (the task, or QA's rework of a late defect).",
                "enum": ["task", "rework"]
              }
            }
          },
          "params": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    }
  }
}
