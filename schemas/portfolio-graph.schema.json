{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mycelink:schema:portfolio-graph",
  "title": "Cross-repository portfolio feature graph",
  "description": "Four-layer decomposition: feature -> repository slice -> capability -> executable node.",
  "type": "object",
  "required": [
    "schema_version",
    "feature_id",
    "title",
    "acceptance_criteria",
    "resources",
    "repositories",
    "capabilities",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "feature_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "prd": { "type": "string" },
    "plan": { "type": "string" },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[A-Za-z0-9_.-]+$" },
          "text": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["new-behavior", "behaviour", "behavior", "compatibility", "declaration"],
            "description": "A new behavior (default; also spelled behaviour, behavior) is evidenced by a test its RED declared and failed; a compatibility criterion by an existing test a green or regression gate passed; a declaration by its GREEN (build, typecheck)."
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["capacity"],
        "additionalProperties": false,
        "properties": {
          "capacity": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "exclusive_with": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "repository", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "repository": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "level",
        "node_type",
        "depends_on",
        "allowed_paths",
        "required_resources",
        "required_evidence",
        "verification_commands",
        "worker"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+\\.[A-Za-z0-9_.-]+$" },
        "level": { "const": "executable-node" },
        "repository": { "type": ["string", "null"] },
        "capability": { "type": ["string", "null"] },
        "node_type": {
          "enum": [
            "contract-lock",
            "red-test",
            "implementation",
            "refactor",
            "regression",
            "review",
            "integration",
            "candidate-build",
            "runtime-deploy",
            "e2e-scenario",
            "knowledge",
            "verification"
          ]
        },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "allowed_paths": { "type": "array", "items": { "type": "string" } },
        "forbidden_paths": { "type": "array", "items": { "type": "string" } },
        "contract_inputs": { "type": "array", "items": { "type": "string" } },
        "contract_outputs": { "type": "array", "items": { "type": "string" } },
        "required_resources": { "type": "array", "items": { "type": "string" } },
        "required_evidence": {
          "type": "array",
          "items": { "enum": ["red", "green", "refactor", "regression", "review", "e2e", "candidate"] }
        },
        "verification_commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "command"],
            "additionalProperties": false,
            "dependentRequired": { "module": ["module_sha256"], "module_sha256": ["module"] },
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "cwd": { "type": "string" },
              "expect_exit": { "type": "integer" },
              "shell": {
                "type": "boolean",
                "description": "Run command[0] as a shell script. Refused unless the control repository sets allow_shell_commands: true."
              },
              "module": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$",
                "description": "The repository module this verifier runs (repositories.yaml modules): its setup and build steps, then exactly `command`, its test argv. Copy it from `mycelink repo modules`."
              },
              "module_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "The hash of the module descriptor the graph was planned against; a changed module is MODULE_DRIFT."
              }
            }
          }
        },
        "worker": {
          "type": "object",
          "required": [
            "model",
            "max_turns",
            "max_wall_clock_minutes",
            "max_attempts",
            "nested_delegation"
          ],
          "additionalProperties": false,
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "effort": { "enum": ["low", "medium", "high"] },
            "max_turns": { "type": "integer" },
            "max_wall_clock_minutes": { "type": "integer" },
            "max_attempts": { "type": "integer" },
            "max_same_failure": { "type": "integer", "minimum": 1 },
            "nested_delegation": { "type": "boolean" }
          }
        },
        "invalidation_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["when", "action"],
            "additionalProperties": false,
            "properties": {
              "when": { "type": "string", "minLength": 1 },
              "action": { "enum": ["INVALIDATE", "BLOCK", "RERUN_REGRESSION"] }
            }
          }
        },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
        "e2e_scenario": { "type": "string" }
      }
    }
  }
}
