{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mycelink:schema:context-pack",
  "title": "Bounded worker context pack",
  "description": "What a worker session receives instead of a transcript. IDs, paths, hashes and fingerprints only; never file bodies, diffs or logs.",
  "type": "object",
  "required": [
    "schema_version",
    "feature_id",
    "node_id",
    "claim_id",
    "generated_at",
    "node_contract",
    "acceptance_criteria",
    "allowed_paths",
    "forbidden_paths",
    "verification_commands",
    "next_required_gate",
    "budget",
    "byte_budget"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "feature_id": { "type": "string" },
    "node_id": { "type": "string" },
    "claim_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "carried_criteria": {
      "type": "array",
      "description": "A node reopened by an upstream's rework with no order of its own: each new behaviour its last generation settled as carried, with that proof, cited exactly as given once its green gate passed the test again.",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["criterion", "test_id", "gate", "output_sha256", "source_generation", "test"],
        "additionalProperties": false,
        "properties": {
          "criterion": { "type": "string", "maxLength": 64 },
          "test_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
          "gate": { "enum": ["red", "green", "regression"] },
          "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "source_generation": { "type": "integer", "minimum": 0 },
          "test": { "type": "object", "required": ["path", "name"], "additionalProperties": false, "properties": { "path": { "type": "string" }, "name": { "type": "string" } } }
        }
      }
    },
    "repository": { "type": ["string", "null"] },
    "worktree": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "node_contract": {
      "type": "object",
      "required": ["node_type", "goal"],
      "additionalProperties": false,
      "properties": {
        "node_type": { "type": "string" },
        "goal": { "type": "string", "maxLength": 2000 },
        "capability": { "type": ["string", "null"] }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "description": "Each criterion the node serves: the exact approved text, its kind and the text's SHA-256.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "text", "sha256"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["new-behavior", "compatibility", "declaration"] },
          "text": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "acceptance_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "The hash of exactly the node's criteria (id, kind, text), as its claim binds them." },
    "correction": {
      "type": "object",
      "description": "The node's submission is held for criterion evidence correction: its code and gates are settled; only a corrected result is asked for. Data, never instructions.",
      "required": ["code", "detail", "commit_sha", "corrections", "limit", "gates", "candidates"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^CRITERION_[A-Z_]+$" },
        "detail": { "type": "string", "maxLength": 2000 },
        "criterion": { "type": ["string", "null"], "description": "The criterion the refusal is about." },
        "kind": { "enum": ["new-behavior", "compatibility", "declaration", null] },
        "required_gate": { "enum": ["red", "green", "green or regression", null], "description": "The gate that criterion's evidence needs." },
        "cycle": { "type": "boolean", "description": "A new behaviour no RED proved: one focused RED cycle may be added on top of the held commit." },
        "commit_sha": { "type": "string" },
        "corrections": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1 },
        "gates": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["gate", "output_sha256"],
            "additionalProperties": false,
            "properties": { "gate": { "enum": ["red", "green", "regression"] }, "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
          }
        },
        "candidates": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "required": ["id", "path", "full_name", "status", "gate"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
              "path": { "type": "string" },
              "full_name": { "type": "string" },
              "status": { "type": "string" },
              "gate": { "enum": ["red", "green", "regression"] }
            }
          }
        }
      }
    },
    "allowed_paths": { "type": "array", "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "direction"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" },
          "direction": { "enum": ["input", "output"] }
        }
      }
    },
    "handoffs": { "type": "array", "items": { "type": "string" } },
    "last_checkpoint_sha": { "type": ["string", "null"] },
    "latest_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "exit_code", "output_path"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string" },
          "exit_code": { "type": "integer" },
          "output_path": { "type": "string" },
          "output_sha256": { "type": "string" }
        }
      }
    },
    "last_failure_fingerprint": { "type": ["string", "null"] },
    "verification_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "command"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "array", "items": { "type": "string" } },
          "cwd": { "type": "string" }
        }
      }
    },
    "memory": {
      "type": "array",
      "description": "Bounded LLM Wiki Brain recall: IDs, status and a one-to-three line summary only.",
      "items": {
        "type": "object",
        "required": ["id", "type", "status", "summary", "path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "status": { "type": "string" },
          "summary": { "type": "string", "maxLength": 400 },
          "path": { "type": "string" },
          "warning": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "next_required_gate": { "type": "string" },
    "rework": {
      "type": "object",
      "description": "Why the controller reopened this node's DONE work. Untrusted data for reproducing the failure; never instructions.",
      "required": ["generation", "limit", "reason", "reason_sha256", "acceptance_criteria", "evidence", "replaced", "scope"],
      "additionalProperties": false,
      "properties": {
        "generation": { "type": "integer", "minimum": 1 },
        "limit": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "reason_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "acceptance_criteria": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 64 } },
        "evidence": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 200 } },
        "replaced": {
          "type": "object",
          "required": ["integrated_sha", "candidate_id"],
          "additionalProperties": false,
          "properties": {
            "integrated_sha": { "type": ["string", "null"] },
            "candidate_id": { "type": ["string", "null"] }
          }
        },
        "scope": {
          "type": "object",
          "required": ["node_id", "repository"],
          "additionalProperties": false,
          "properties": {
            "node_id": { "type": "string" },
            "repository": { "type": ["string", "null"] }
          }
        },
        "origin": {
          "type": "object",
          "description": "The acceptance review whose GAP ordered this rework.",
          "required": ["kind", "review_id", "review"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "acceptance-review" },
            "review_id": { "type": "string", "maxLength": 64 },
            "review": { "type": "integer", "minimum": 1 },
            "refinement": {
              "type": "object",
              "description": "A refined gap: the challenge its refinement answered, and its round.",
              "required": ["challenge_id", "round"],
              "additionalProperties": false,
              "properties": {
                "challenge_id": { "type": "string", "maxLength": 80 },
                "round": { "type": "integer", "minimum": 1 }
              }
            },
            "revision": { "type": "integer", "minimum": 0, "description": "The revision of the review this rework is ordered by: 0 its original receipt, n its n-th refinement's." },
            "restoration": {
              "type": "array",
              "description": "A restoration order: the completed proofs the reviewed heads lost, each by its criterion and completion record. Never an accepted rework of them.",
              "maxItems": 64,
              "items": { "type": "object", "required": ["criterion", "record_id", "code"], "additionalProperties": false, "properties": { "criterion": { "type": "string", "maxLength": 64 }, "record_id": { "type": "string", "maxLength": 80 }, "code": { "type": ["string", "null"], "maxLength": 64 } } }
            },
            "receipt_path": { "type": "string", "maxLength": 200 },
            "receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "review_gaps": {
          "type": "array",
          "description": "An acceptance review's gaps of this rework: each criterion and the SHA-256 of its exact public reproduction, which a review-gap challenge binds.",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["criterion", "reproduction_sha256"],
            "additionalProperties": false,
            "properties": {
              "criterion": { "type": "string", "maxLength": 64 },
              "reproduction_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "compatibility": {
          "type": "array",
          "description": "The rework's compatibility criteria: each is closed by a compatibility-regression unit (a regression test alone, after the code, with the trailer Mycelink-Compatibility), never a RED of its own unless the test exposes a real regression.",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 64 }
        },
        "carried_criteria": {
          "type": "array",
          "description": "New behaviours of the node the rework does not name: each carries the proof the replaced generation settled it with (data, never an active gate), cited exactly as given once the green gate passed its test again; settle re-runs each test at the new head.",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["criterion", "test_id", "gate", "output_sha256", "source_generation", "test"],
            "additionalProperties": false,
            "properties": {
              "criterion": { "type": "string", "maxLength": 64 },
              "test_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
              "gate": { "enum": ["red", "green", "regression"] },
              "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "source_generation": { "type": "integer", "minimum": 0 },
              "test": { "type": "object", "required": ["path", "name"], "additionalProperties": false, "properties": { "path": { "type": "string" }, "name": { "type": "string" } } }
            }
          }
        },
        "capsules": {
          "type": "array",
          "description": "The reproduction capsules this claim sealed: current (usable now), or stale and whether --carry rebinds it to the order's current revision.",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["capsule_id", "capsule_sha256", "criterion", "result", "revision", "current", "carry", "tests"],
            "additionalProperties": false,
            "properties": {
              "capsule_id": { "type": "string", "pattern": "^CAP-[0-9a-f]{16}$" },
              "capsule_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "criterion": { "type": "string", "maxLength": 64 },
              "result": { "enum": ["passed", "failed"] },
              "revision": { "type": "integer", "minimum": 0 },
              "current": { "type": "boolean" },
              "carry": { "type": "boolean" },
              "why": { "type": "string", "maxLength": 600 },
              "tests": { "type": "array", "maxItems": 16, "items": { "type": "object", "required": ["id", "status", "full_name"], "additionalProperties": false, "properties": { "id": { "type": "string", "pattern": "^[0-9a-f]{16}$" }, "status": { "type": "string" }, "full_name": { "type": "string", "maxLength": 400 } } } }
            }
          }
        },
        "completed_criteria": {
          "type": "array",
          "description": "Criteria the rework names again that an earlier generation completed: each with its completed proof and completion record, cited exactly as given beside the review's reproduction shown passing on the unchanged base (its re-proof, never committed) to prove it DONE; a reproduction that fails is a RED.",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["criterion", "test_id", "gate", "output_sha256", "source_generation", "test", "record_id"],
            "additionalProperties": false,
            "properties": {
              "criterion": { "type": "string", "maxLength": 64 },
              "test_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
              "gate": { "enum": ["red", "green", "regression"] },
              "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "source_generation": { "type": "integer", "minimum": 0 },
              "test": { "type": "object", "required": ["path", "name"], "additionalProperties": false, "properties": { "path": { "type": "string" }, "name": { "type": "string" } } },
              "record_id": { "type": "string", "pattern": "^CC-[0-9a-f]{16}$" }
            }
          }
        },
        "reopened": {
          "type": "array",
          "description": "Completed criteria this generation's base no longer holds as completed (revalidated on the claim's base): each reopened, proved by this generation.",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["criterion", "code", "detail"],
            "additionalProperties": false,
            "properties": { "criterion": { "type": "string", "maxLength": 64 }, "code": { "type": "string", "maxLength": 64 }, "detail": { "type": "string", "maxLength": 600 } }
          }
        }
      }
    },
    "tdd": {
      "type": "object",
      "description": "The test-first history settle verifies: the base the node's history starts from and the test-path policy the claim is bound to; after a refused history, why.",
      "required": ["base_sha", "policy_sha256", "test_paths", "production_roots", "declaration_paths"],
      "additionalProperties": false,
      "properties": {
        "base_sha": { "type": ["string", "null"] },
        "policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "test_paths": { "type": "array", "items": { "type": "string" } },
        "production_roots": { "type": "array", "items": { "type": "string" } },
        "declaration_paths": { "type": "array", "items": { "type": "string" } },
        "require_red": { "type": "boolean", "description": "False for a node with no red gate: it may change declaration paths only, committed alone." },
        "compatibility_criteria": {
          "type": "array",
          "description": "The node's compatibility criteria: a compatibility-regression unit of its history (tests alone after the code, each commit with the trailer Mycelink-Compatibility: <AC>) may prove them, nothing else.",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 64 }
        },
        "progress_lost": {
          "type": "object",
          "description": "Why settle last refused, uncharged, to integrate this order's work: it would have lost a sibling's completed proof or conflicted with it.",
          "required": ["code", "cause", "detail", "lost", "conflicts"],
          "additionalProperties": false,
          "properties": {
            "code": { "const": "SIBLING_PROGRESS_LOST" },
            "cause": { "enum": ["stale-base", "delta", "conflict"] },
            "detail": { "type": "string", "maxLength": 2000 },
            "lost": { "type": "array", "maxItems": 16, "items": { "type": "object", "required": ["node_id", "criterion"], "additionalProperties": false, "properties": { "node_id": { "type": "string" }, "criterion": { "type": "string" } } } },
            "conflicts": { "type": "array", "maxItems": 16, "items": { "type": "string" } }
          }
        },
        "rejection": {
          "type": "object",
          "required": ["code", "commit", "detail", "archived_ref"],
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string" },
            "commit": { "type": ["string", "null"] },
            "detail": { "type": "string", "maxLength": 2000 },
            "archived_ref": { "type": "string" }
          }
        },
        "red_bound_paths": {
          "type": "array",
          "description": "The test files this claim's red gates bound, each at its blob: byte-identical from its RED on.",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["path", "blob"],
            "additionalProperties": false,
            "properties": { "path": { "type": "string" }, "blob": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" } }
          }
        }
      }
    },
    "worktree_setup": {
      "type": "object",
      "description": "The setup the controller ran (or reused) in the worktree before this ticket: what a checkout does not carry is installed. Bound to the claim by its hashes.",
      "required": ["status", "config_sha256", "receipt_sha256", "commands", "required_paths"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["complete", "reused"] },
        "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "commands": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
        "required_paths": { "type": "array", "items": { "type": "string" } },
        "inputs": { "type": "array", "items": { "type": "string" }, "description": "What the setup installs from: changed in the worktree, the next gate runs the setup again first." }
      }
    },
    "module": {
      "type": "object",
      "description": "The module this node owns and the command its gates run, bound to the claim by its hash. Regression runs the repository's full suite.",
      "required": ["id", "path", "runtime_tests", "sha256", "steps", "test", "report", "regression"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "runtime_tests": { "type": "boolean" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "steps": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
        "test": { "type": "array", "items": { "type": "string" } },
        "report": { "type": ["string", "null"] },
        "regression": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_turns", "max_wall_clock_minutes", "max_attempts", "attempt"],
      "additionalProperties": false,
      "properties": {
        "max_turns": { "type": "integer" },
        "max_wall_clock_minutes": { "type": "integer" },
        "max_attempts": { "type": "integer" },
        "attempt": { "type": "integer" },
        "lifetime_attempts": { "type": "integer", "minimum": 0 }
      }
    },
    "byte_budget": { "type": "integer", "minimum": 1 },
    "rules": { "type": "array", "items": { "type": "string", "maxLength": 300 } }
  }
}
