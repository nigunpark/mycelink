{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mycelink:schema:repositories",
  "title": "Portfolio repository manifest",
  "type": "object",
  "required": ["schema_version", "repositories"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repository" }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "required": ["name", "path", "base_branch", "commands"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64 },
        "path": { "type": "string", "minLength": 1 },
        "base_branch": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "description": { "type": "string" },
        "baseline_failures": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tests known to fail before the feature starts; excluded from regression attribution."
        },
        "tdd": {
          "type": "object",
          "description": "Which paths are tests for the test-first history check. Each list replaces its default; declaration paths are production that can carry no runtime test.",
          "additionalProperties": false,
          "properties": {
            "test_paths": { "$ref": "#/$defs/globs" },
            "production_roots": { "$ref": "#/$defs/globs" },
            "declaration_paths": { "$ref": "#/$defs/globs" }
          }
        },
        "worktree_setup": { "$ref": "#/$defs/worktreeSetup" },
        "module_defaults": { "$ref": "#/$defs/moduleCommands" },
        "modules": {
          "type": "array",
          "maxItems": 256,
          "description": "How each module verifies itself: module-scoped, shell-free setup, build and test argv. A node's gates run its module's; the full suite (commands.test) stays the regression and candidate command.",
          "items": { "$ref": "#/$defs/module" }
        },
        "commands": {
          "type": "object",
          "required": ["test"],
          "additionalProperties": false,
          "properties": {
            "build": { "$ref": "#/$defs/argv" },
            "test": { "$ref": "#/$defs/argv" },
            "lint": { "$ref": "#/$defs/argv" },
            "regression": { "$ref": "#/$defs/argv" },
            "start": { "$ref": "#/$defs/argv" },
            "stop": { "$ref": "#/$defs/argv" },
            "healthcheck": { "$ref": "#/$defs/argv" }
          }
        }
      }
    },
    "worktreeSetup": {
      "type": "object",
      "required": ["commands"],
      "additionalProperties": false,
      "description": "What every new worktree of this repository needs before anything runs in it (dependencies a checkout does not carry). The controller runs it, argv only and never through a shell, before a worker or verifier uses the worktree.",
      "properties": {
        "commands": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/argv" } },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "env": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" },
          "additionalProperties": { "type": "string", "maxLength": 4096 },
          "description": "Values may use only the ${HOME}, ${WORKTREE} and ${TMPDIR} placeholders."
        },
        "required_paths": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "description": "Paths inside the worktree the setup must leave (and that must still exist for its receipt to be reused)."
        },
        "inputs": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "description": "Globs of the tracked files the setup installs from (a dependency manifest, a lockfile). The receipt binds their content; a gate that finds them changed in its worktree runs the setup there again first."
        }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "argv form only. A shell string is rejected so arguments are never re-split."
    },
    "argvList": { "type": ["array", "null"], "maxItems": 8, "items": { "$ref": "#/$defs/argv" } },
    "moduleReport": {
      "type": ["object", "null"],
      "required": ["format"],
      "additionalProperties": false,
      "properties": {
        "format": { "enum": ["vitest-json", "junit-xml"] },
        "dir": { "type": "string", "minLength": 1, "maxLength": 256, "description": "A report directory inside the checkout (Surefire). Absent: ${REPORT} in the test argv names a controller-owned file." }
      }
    },
    "moduleCommands": {
      "type": "object",
      "additionalProperties": false,
      "description": "Argv only, never a shell. ${MODULE_PATH} and ${MODULE_ID} are filled in; ${REPORT} (test only) names the report file at run time. null unsets an inherited value.",
      "properties": {
        "setup": { "$ref": "#/$defs/argvList" },
        "build": { "$ref": "#/$defs/argvList" },
        "test": { "type": ["array", "null"], "minItems": 1, "items": { "type": "string" } },
        "report": { "$ref": "#/$defs/moduleReport" },
        "timeout_seconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 7200 }
      }
    },
    "module": {
      "type": "object",
      "required": ["id", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 64 },
        "path": { "type": "string", "minLength": 1, "maxLength": 256 },
        "runtime_tests": { "type": "boolean", "description": "false for declarations or documentation only: no runtime test, no RED. Default true." },
        "setup": { "$ref": "#/$defs/argvList" },
        "build": { "$ref": "#/$defs/argvList" },
        "test": { "type": ["array", "null"], "minItems": 1, "items": { "type": "string" } },
        "report": { "$ref": "#/$defs/moduleReport" },
        "timeout_seconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 7200 }
      }
    },
    "globs": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f]+$" }
    }
  }
}
