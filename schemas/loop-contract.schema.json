{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mycelink:schema:loop-contract",
  "title": "Persistent loop contract",
  "description": "A loop without trigger, success condition, stop conditions, deterministic verifier and budget must be refused before it runs.",
  "type": "object",
  "required": [
    "loop_id",
    "loop_type",
    "scope",
    "trigger",
    "authoritative_inputs",
    "action",
    "deterministic_verifier",
    "feedback_schema",
    "success_condition",
    "stop_conditions",
    "max_attempts",
    "max_same_failure",
    "max_model_turns",
    "max_wall_clock_ms",
    "max_usage_budget",
    "on_success",
    "on_failure",
    "on_budget_exhausted",
    "state_path",
    "evidence_path"
  ],
  "additionalProperties": false,
  "properties": {
    "loop_id": { "type": "string", "minLength": 1 },
    "loop_type": {
      "enum": ["node-agent", "verification", "feature-orchestration", "runtime-e2e", "review", "harness-improvement"]
    },
    "scope": { "enum": ["feature", "node", "runtime", "review", "harness"] },
    "parent_loop_id": { "type": ["string", "null"] },
    "trigger": { "type": "string", "minLength": 1 },
    "authoritative_inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "action": { "type": "string", "minLength": 1 },
    "deterministic_verifier": {
      "type": "object",
      "required": ["kind", "command"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["command", "controller"] },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "expect_exit": { "type": "integer" }
      }
    },
    "feedback_schema": { "type": "string", "minLength": 1 },
    "success_condition": { "type": "string", "minLength": 1 },
    "stop_conditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "max_attempts": { "type": "integer", "minimum": 1 },
    "max_same_failure": { "type": "integer", "minimum": 1 },
    "max_model_turns": { "type": "integer", "minimum": 1 },
    "max_wall_clock_ms": { "type": "integer", "minimum": 1 },
    "max_usage_budget": {
      "type": "object",
      "required": ["input_tokens", "output_tokens"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 1 },
        "output_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "backoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initial_ms": { "type": "integer", "minimum": 0 },
        "factor": { "type": "number", "minimum": 1 },
        "max_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "required_resource": { "type": "array", "items": { "type": "string" } },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "human_gate": { "type": "boolean" },
    "on_success": { "type": "string", "minLength": 1 },
    "on_failure": { "type": "string", "minLength": 1 },
    "on_budget_exhausted": { "type": "string", "minLength": 1 },
    "state_path": { "type": "string", "minLength": 1 },
    "evidence_path": { "type": "string", "minLength": 1 }
  }
}
