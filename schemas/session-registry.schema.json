{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mycelink:schema:session-registry",
  "title": "Worker session registry",
  "type": "object",
  "required": ["schema_version", "sessions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "sessions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/session" } }
  },
  "$defs": {
    "session": {
      "type": "object",
      "required": [
        "session_id",
        "feature_id",
        "node_id",
        "claim_id",
        "status",
        "started_at",
        "last_progress_at",
        "turns",
        "usage",
        "adapter"
      ],
      "additionalProperties": false,
      "properties": {
        "session_id": { "type": "string" },
        "feature_id": { "type": "string" },
        "node_id": { "type": "string" },
        "claim_id": { "type": "string" },
        "repository": { "type": ["string", "null"] },
        "worktree": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "status": {
          "enum": ["spawning", "working", "stalled", "done", "failed", "blocked", "needs-decision", "stopped", "budget-exhausted"]
        },
        "started_at": { "type": "string" },
        "last_progress_at": { "type": "string" },
        "finished_at": { "type": ["string", "null"] },
        "turns": { "type": "integer", "minimum": 0 },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model_turns": { "type": "integer", "minimum": 0 },
            "wall_clock_ms": { "type": "integer", "minimum": 0 },
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 }
          }
        },
        "adapter": { "enum": ["claude-cli", "codex-cli", "fake-provider", "fake-claude", "claude-background"] },
        "pid": { "type": ["integer", "null"] },
        "log_path": { "type": ["string", "null"] },
        "result_path": { "type": ["string", "null"] },
        "exit_code": { "type": ["integer", "null"] },
        "replaces_session_id": { "type": ["string", "null"] },
        "attempt": { "type": "integer", "minimum": 1 },
        "codex_evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["provider", "source", "process_session_id", "thread_id", "terminal", "turns", "final", "failure", "role_attested"],
          "properties": {
            "provider": { "const": "codex" }, "source": { "const": "exec-jsonl" }, "process_session_id": { "type": "string" },
            "thread_id": { "type": ["string", "null"] }, "terminal": { "enum": ["completed", "failed", "incomplete", "invalid"] },
            "turns": { "type": "integer", "minimum": 0 }, "role_attested": { "const": false },
            "final": { "type": ["object", "null"], "additionalProperties": false,
              "required": ["item_id", "sha256", "bytes"],
              "properties": { "item_id": { "type": "string" }, "sha256": { "type": "string" }, "bytes": { "type": "integer", "minimum": 0 } } },
            "failure": { "type": ["object", "null"], "additionalProperties": false,
              "required": ["class", "transient"], "properties": { "class": { "const": "unclassified" }, "transient": { "const": false } } }
          }
        },
        "codex_provenance": {
          "type": "object", "additionalProperties": false, "required": ["provider", "process_session_id", "worker_result", "reviewer_verdict"],
          "properties": { "provider": { "const": "codex" }, "process_session_id": { "type": "string" }, "reviewer_verdict": { "type": "null" },
            "worker_result": { "type": ["object", "null"], "additionalProperties": false,
              "required": ["source", "attested", "node_id", "claim_id", "sha256"],
              "properties": { "source": { "const": "worktree-result-slot" }, "attested": { "const": false },
                "node_id": { "type": "string" }, "claim_id": { "type": "string" }, "sha256": { "type": "string" } } }
          }
        }
      }
    }
  }
}
